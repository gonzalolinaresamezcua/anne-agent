{
  "name": "anne-agent",
  "version": "0.1.0",
  "description": "CLI multiagente open-source: convierte encargos en lenguaje natural en un DAG y los ejecuta en paralelo con Cursor SDK",
  "type": "module",
  "bin": {
    "anne": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "anne": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "cursor-sdk",
    "cli",
    "typescript",
    "agent-orchestration",
    "linux",
    "automation",
    "aitarea",
    "cursor",
    "anne"
  ],
  "author": "digitacode.es",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonzalolinaresamezcua/anne-agent.git"
  },
  "bugs": {
    "url": "https://github.com/gonzalolinaresamezcua/anne-agent/issues"
  },
  "homepage": "https://github.com/gonzalolinaresamezcua/anne-agent#readme",
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "ora": "^9.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
